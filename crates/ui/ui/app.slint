import { ListView } from "std-widgets.slint";
// Colours follow Telegram Desktop's night theme; OLED mode turns surfaces black.
export global Theme {
    in-out property <bool> oled: false;
    out property <color> window: oled ? #000000 : #0e1621;
    out property <color> panel: oled ? #000000 : #17212b;
    out property <color> field: oled ? #000000 : #242f3d;
    out property <color> incoming: oled ? #101010 : #182533;
    out property <color> outgoing: oled ? #0b2236 : #2b5278;
    out property <color> selected: oled ? #0b2236 : #2b5278;
    out property <color> hover: oled ? #101010 : #202b36;
    out property <color> date: oled ? #1a1a1acc : #1e2c3acc;
    out property <color> border: oled ? #1a1a1a : #0b131b;
    out property <color> text: #ffffff;
    out property <color> muted: #7f91a4;
    out property <color> time-in: #6d7f8f;
    out property <color> time-out: #7da8d3;
    out property <color> check: #72bcfd;
    out property <color> badge: #3e88c7;
    out property <color> accent: #6ab3f3;
}
export struct ChatRow { avatar: image, initials: string, color: color, title: string, preview: string, time: string, unread: string, mentions: string, muted: bool, selected: bool }
export struct WaveBar { amplitude: length, played: bool }
export struct PhotoCell { raster-width: length, raster-height: length, image: image, label: string, x: length, y: length, width: length, height: length, video: bool, duration: string }
// One feed row: a date separator (optional) and one bubble holding a message or an album.
export struct MessageRow {
    voice: bool, voice-playing: bool, voice-unlistened: bool, voice-time: string, waveform: [WaveBar],
    document: bool, file-name: string, file-size: string, file-progress: string,
    file-available: bool, file-downloading: bool, attachment-image: image, attachment-y: length,
    sticker: bool, round: bool, emoji: bool, round-progress: string,
    key: string, can-edit: bool, can-delete: bool, can-forward: bool, can-reply: bool,
    highlighted: bool, forwarded: string, sender-y: length,
    has-quote: bool, quote-y: length, quote-sender: string, quote-preview: string, quote-color: color,
    time-label-width: length,
    row-y: length, height: length, date: string, unread: bool, unread-y: length,
    bubble-y: length, bubble-width: length, bubble-height: length, outgoing: bool, tail: bool,
    sender: string, sender-color: color,
    media-y: length, media-width: length, media-height: length, media-caption: bool, cells: [PhotoCell],
    rendered: image, text-y: length, text-width: length, text-height: length,
    time: string, time-x: length, time-y: length, time-over-media: bool,
    // 0 none, 1 sent, 2 read, -1 sending, -2 failed.
    checks: int,
}
component Action inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 40px;
    min-width: 80px;
    border-radius: 6px;
    background: touch.has-hover && root.enabled ? #4a96d6 : Theme.badge;
    opacity: root.enabled ? 1 : 0.5;
    Text { text: root.text; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; font-size: 14px; font-weight: 600; }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}
component Link inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    Text { text: root.text; color: touch.has-hover ? #8ccaff : Theme.accent; horizontal-alignment: center; vertical-alignment: center; font-size: 14px; }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}
component Input inherits Rectangle {
    in-out property <string> text;
    in property <bool> secret;
    callback accepted();
    height: 44px;
    border-radius: 6px;
    border-width: 1px;
    border-color: entry.has-focus ? Theme.accent : #2f3e4e;
    background: Theme.field;
    entry := TextInput {
        x: 12px; y: 11px; width: parent.width - 24px; height: 22px;
        text <=> root.text;
        color: Theme.text;
        selection-background-color: #2b5278;
        selection-foreground-color: #ffffff;
        font-size: 15px;
        single-line: true;
        input-type: root.secret ? InputType.password : InputType.text;
        accepted => { root.accepted(); }
    }
}
// One row of the message menu: an outline icon (24-unit path) and a label, as in Telegram.
component MenuRow inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked();
    height: 38px;
    background: touch.has-hover && root.enabled ? #ffffff12 : transparent;
    Path {
        x: 16px; y: (parent.height - 20px) / 2; width: 20px; height: 20px;
        viewbox-width: 24; viewbox-height: 24;
        commands: root.icon; fill: transparent;
        stroke: root.enabled ? #e8edf2 : Theme.muted; stroke-width: 1.6px;
    }
    Text {
        x: 52px; width: parent.width - 64px; height: parent.height; text: root.text; font-size: 14px;
        vertical-alignment: center;
        color: root.enabled ? Theme.text : Theme.muted;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}
component Avatar inherits Rectangle {
    in property <image> source;
    in property <string> initials;
    in property <color> tint;
    border-radius: self.width / 2;
    clip: true;
    background: root.tint;
    Text { text: root.initials; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; font-size: root.width * 0.36; font-weight: 600; }
    Image { source: root.source; width: parent.width; height: parent.height; image-fit: cover; }
}
export component AppWindow inherits Window {
    in property <string> window-title: "Ferrogram";
    title: root.window-title;
    icon: @image-url("icon.png");
    in property <string> open-unread;
    preferred-width: 1040px;
    preferred-height: 740px;
    min-width: 700px;
    min-height: 520px;
    background: Theme.window;
    default-font-family: "Segoe UI";
    in property <bool> ready;
    in property <bool> demo;
    in property <bool> blocked;
    in-out property <bool> security-warning;
    in property <string> error;
    in property <string> auth-title: "Starting Telegram";
    // 0 connecting, 1 QR, 2 phone, 3 code, 4 password.
    in-out property <int> auth-step;
    in property <image> qr;
    in property <[ChatRow]> chats;
    in property <[MessageRow]> messages;
    in property <image> chat-avatar;
    in property <string> chat-initials;
    in property <color> chat-color: #65aadd;
    in property <string> chat-title: "";
    in property <bool> chat-open;
    in property <bool> more-chats: true;
    in-out property <length> feed-y;
    in property <length> feed-content-height;
    in-out property <length> feed-height: 500px;
    in-out property <length> chat-y;
    in-out property <length> chat-height: 600px;
    // Row height matches CHAT_ROW in models.rs.
    out property <bool> chat-near-end: root.chats.length * 62px + root.chat-y < root.chat-height * 3;
    in property <bool> at-newest: true;
    in-out property <length> feed-left;
    in-out property <length> feed-top;
    in-out property <length> feed-view-width;
    callback viewport-changed();
    callback wheel(delta: length);
    callback chat-viewport-changed();
    callback media-ready();
    changed chat-y => { root.chat-viewport-changed(); }
    changed chat-height => { root.chat-viewport-changed(); }
    in-out property <string> auth-input;
    in-out property <string> draft;
    // Maximum bubble width: the history area minus side margins, at most 504 px.
    out property <length> feed-width: max(80px, min(504px, root.width - 300px - 48px));
    changed feed-width => { root.width-changed(); }
    callback width-changed();
    callback drain-events();
    callback auth-submit();
    callback request-qr();
    callback open-chat(index: int);
    // Opens the video of a feed cell in the separate media viewer window.
    callback open-video(row: int, cell: int);
    callback attachment-action(key: string, action: int, fraction: float);
    callback confirm-file();
    in property <string> file-name;

    callback load-chats();
    callback send();
    callback logout();
    callback demo-toggle();
    callback clear-highlight();
    in-out property <bool> composer-focus;
    public function focus-composer() { root.composer-focus = !root.composer-focus; }
    callback latest();
    // Action IDs: 0 reply, 1 edit, 2 copy, 3 forward, 4 delete, 5 open quote.
    callback message-action(key: string, action: int);
    // In-window message menu (see the comment at the message bubble).
    in-out property <bool> menu-open;
    changed menu-open => { root.viewport-changed(); }
    in-out property <length> menu-x;
    in-out property <length> menu-y;
    in-out property <string> menu-key;
    in-out property <bool> menu-can-reply;
    in-out property <bool> menu-can-edit;
    in-out property <bool> menu-can-forward;
    in-out property <bool> menu-can-delete;
    in-out property <bool> menu-can-reveal;
    function open-menu(key: string, reply: bool, edit: bool, forward: bool, delete: bool, reveal: bool, x: length, y: length) {
        root.menu-key = key;
        root.menu-can-reply = reply;
        root.menu-can-edit = edit;
        root.menu-can-forward = forward;
        root.menu-can-delete = delete;
        root.menu-can-reveal = reveal;
        root.menu-x = x;
        root.menu-y = y;
        root.menu-open = true;
    }
    function menu-pick(action: int) {
        root.menu-open = false;
        root.message-action(root.menu-key, action);
    }
    callback cancel-action();
    callback confirm-delete();
    callback forward-to(index: int);
    callback filter-destinations(query: string);
    in property <[ChatRow]> destinations;
    in-out property <string> forward-query;
    changed forward-query => { root.filter-destinations(root.forward-query); }
    in property <string> composer-title;
    in property <string> composer-preview;
    in property <bool> editing;
    in property <bool> edit-saving;
    in-out property <length> destination-y;
    changed destination-y => { root.chat-viewport-changed(); }
    // 0 closed, 1 delete confirmation, 2 forward destination.
    in-out property <int> action-dialog;
    changed action-dialog => { root.viewport-changed(); }
    in property <bool> can-revoke;
    in property <bool> must-revoke;
    in-out property <bool> revoke;
    public function copy-text(value: string) {
        clipboard.text = value; clipboard.select-all(); clipboard.copy(); clipboard.text = "";
    }
    clipboard := TextInput { visible: false; }
    in-out property <bool> follow-tail: true;
    VerticalLayout {
        padding: 0px; spacing: 0px;
        if root.demo: Rectangle {
            height: 40px; background: Theme.panel;
            HorizontalLayout { padding: 4px; padding-left: 14px; spacing: 10px;
                Text { min-width: 300px; horizontal-stretch: 1; text: "DEMO / Synthetic data / no account or key files"; color: Theme.accent; font-size: 12px; vertical-alignment: center; }
                Link { width: 140px; text: root.ready ? "Preview sign-in" : "Back to chats"; clicked => { root.demo-toggle(); } }
                Link { width: 120px; text: "TPM warning"; clicked => { root.security-warning = !root.security-warning; } }
            }
        }
        if root.security-warning: Rectangle {
            height: 40px; background: #3a2d1b;
            Text { x: 16px; width: parent.width - 32px; text: "Security warning: TPM unavailable. The database key is protected by Windows DPAPI only."; color: #edbb76; font-size: 13px; wrap: word-wrap; vertical-alignment: center; }
        }
        if root.error != "": Rectangle {
            height: 40px; background: #3b2226;
            Text { x: 16px; width: parent.width - 32px; text: root.error; color: #ffb4b4; font-size: 13px; wrap: word-wrap; vertical-alignment: center; }
        }
        if !root.ready: Rectangle {
            background: Theme.window;
            VerticalLayout {
                alignment: center; padding: 50px; spacing: 16px;
                HorizontalLayout { alignment: center;
                    Image { width: 112px; height: 112px; source: @image-url("icon.png"); image-fit: contain; }
                }
                Text { text: root.auth-step == 2 ? "Sign in to Telegram" : root.auth-title; color: Theme.text; font-size: 22px; font-weight: 600; horizontal-alignment: center; }
                if root.auth-step == 1: VerticalLayout {
                    alignment: center; spacing: 14px;
                    HorizontalLayout { alignment: center;
                        Rectangle { width: 232px; height: 232px; background: #ffffff; border-radius: 12px; Image { x: 6px; y: 6px; width: 220px; height: 220px; source: root.qr; image-fit: contain; } }
                    }
                    Text { text: "Open Telegram on your phone, go to Settings > Devices > Link Desktop Device and scan this code."; color: Theme.muted; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
                    HorizontalLayout { alignment: center;
                        Link { width: 220px; text: "Log in by phone number"; enabled: !root.blocked; clicked => { root.auth-input = ""; root.auth-step = 2; } }
                    }
                }
                if root.auth-step >= 2: HorizontalLayout { alignment: center;
                    VerticalLayout {
                        width: 340px; spacing: 12px;
                        Text { text: root.auth-step == 2 ? "Please confirm your country code and enter your phone number." : root.auth-step == 3 ? "Enter the code Telegram sent you." : "Your account is protected with an additional password."; color: Theme.muted; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; }
                        Input { text <=> root.auth-input; secret: root.auth-step == 4; accepted => { if !root.blocked { root.auth-submit(); } } }
                        Action { text: "NEXT"; enabled: !root.blocked && root.auth-input != ""; clicked => { root.auth-submit(); } }
                        Link { text: "Log in by QR code"; enabled: !root.blocked; clicked => { root.auth-input = ""; root.request-qr(); } }
                    }
                }
            }
        }
        if root.ready: HorizontalLayout {
            spacing: 0px; padding: 0px;
            Rectangle {
                width: 300px; background: Theme.panel;
                VerticalLayout {
                    padding: 0px; spacing: 0px;
                    Rectangle { height: 54px; background: Theme.panel;
                        menu-button := Rectangle {
                            x: 10px; y: 9px; width: 36px; height: 36px; border-radius: 18px;
                            background: menu-touch.has-hover ? Theme.hover : transparent;
                            Path { x: 9px; y: 11px; width: 18px; height: 14px; viewbox-width: 18; viewbox-height: 14;
                                stroke: Theme.muted; stroke-width: 2px; fill: transparent;
                                commands: "M0 1 L18 1 M0 7 L18 7 M0 13 L18 13"; }
                            menu-touch := TouchArea { clicked => { menu.show(); } }
                        }
                        Text { x: 58px; text: "Chats"; color: Theme.text; font-size: 16px; font-weight: 600; vertical-alignment: center; height: parent.height; }
                        menu := PopupWindow {
                            x: 10px; y: 48px; width: 200px; height: 52px;
                            Rectangle { background: Theme.field; border-radius: 8px; drop-shadow-blur: 12px; drop-shadow-color: #00000080;
                                Rectangle { x: 0px; y: 6px; width: parent.width; height: 40px;
                                    background: logout-touch.has-hover ? #2f3e4e : transparent;
                                    Text { x: 16px; text: "Log out"; color: root.demo ? Theme.muted : Theme.text; font-size: 14px; vertical-alignment: center; height: parent.height; }
                                    logout-touch := TouchArea { enabled: !root.blocked && !root.demo; clicked => { root.logout(); } }
                                }
                            }
                        }
                    }
                    chat-list := ListView {
                        changed visible-height => { root.chat-height = self.visible-height; }
                        // Bound to the position itself, so the wheel animation updates it on every
                        // frame; `scrolled` fires only for the input event that started it.
                        content-y <=> root.chat-y;
                        scrolled => { if root.chat-near-end && root.more-chats { root.load-chats(); } }
                        in property <int> chat-count: root.chats.length;
                        changed chat-count => { if root.chat-near-end && root.more-chats { root.load-chats(); } }
                        for chat[index] in root.chats: Rectangle {
                            height: 62px;
                            background: chat.selected ? Theme.selected : row-touch.has-hover ? Theme.hover : Theme.panel;
                            Avatar { x: 10px; y: 8px; width: 46px; height: 46px; source: chat.avatar; initials: chat.initials; tint: chat.color; }
                            Text { x: 68px; y: 9px; width: parent.width - 68px - 62px; height: 20px; text: chat.title; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                            Text { x: parent.width - 60px; y: 10px; width: 50px; height: 18px; text: chat.time; color: chat.selected ? #ffffffb0 : Theme.muted; font-size: 12px; horizontal-alignment: right; }
                            Text { x: 68px; y: 32px; width: parent.width - 68px - (chat.unread != "" || chat.mentions != "" ? 90px : 12px); height: 20px; text: chat.preview; color: chat.selected ? #ffffffd0 : Theme.muted; font-size: 13px; overflow: elide; }
                            if chat.unread != "" || chat.mentions != "": Rectangle {
                                height: 20px; width: max(20px, badge-text.preferred-width + 12px);
                                x: parent.width - self.width - 10px; y: 33px; border-radius: 10px;
                                background: chat.muted ? #637383 : chat.selected ? #ffffff : Theme.badge;
                                badge-text := Text { text: chat.mentions != "" ? "@" + chat.mentions + (chat.unread != "" ? " / " + chat.unread : "") : chat.unread; color: chat.selected ? Theme.selected : #ffffff; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            row-touch := TouchArea { enabled: !root.blocked; clicked => { root.open-chat(index); } }
                        }
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.border; }
            Rectangle {
                background: Theme.window;
                VerticalLayout {
                    padding: 0px; spacing: 0px;
                    if root.chat-open: Rectangle { height: 54px; background: Theme.panel;
                        Avatar { x: 14px; y: 8px; width: 38px; height: 38px; source: root.chat-avatar; initials: root.chat-initials; tint: root.chat-color; }
                        Text { x: 64px; width: parent.width - 80px; height: parent.height; text: root.chat-title; color: Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                    }
                    feed-area := Rectangle {
                        clip: true;
                        property <length> location-x: self.absolute-position.x;
                        property <length> location-y: self.absolute-position.y;
                        changed location-x => { root.feed-left=self.location-x; root.viewport-changed(); }
                        changed location-y => { root.feed-top=self.location-y; root.viewport-changed(); }
                        changed width => { root.feed-view-width=self.width; root.viewport-changed(); }
                        changed height => { root.feed-height = self.height; root.viewport-changed(); }
                        wheel-area := TouchArea {
                            width: parent.width; height: parent.height;
                            scroll-event(event) => {
                                if root.blocked { return reject; }
                                root.wheel(event.delta-y);
                                return accept;
                            }
                        feed := Flickable {
                            width: parent.width; height: parent.height;
                            content-width: self.width;
                            content-height: max(self.height, root.feed-content-height);
                            content-y <=> root.feed-y;
                            // Wheel and touchpad scrolling run in Rust (see State::wheel): Slint's
                            // own wheel animation keeps its old target when a page is prepended.
                            interactive: false;
                            changed content-y => { root.viewport-changed(); }
                            for msg[row] in root.messages: Rectangle {
                                // Rows sit at the bottom when the history is shorter than the view.
                                y: msg.row-y + max(0px, feed.height - root.feed-content-height);
                                width: feed.width; height: msg.height;
                                if msg.date != "": Rectangle {
                                    y: 10px; height: 24px; width: date-text.preferred-width + 22px;
                                    x: (parent.width - self.width) / 2; border-radius: 12px; background: Theme.date;
                                    date-text := Text { text: msg.date; color: Theme.text; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                if msg.unread: Rectangle { y: msg.unread-y; width: parent.width; height: 30px; background: Theme.panel;
                                    Text { text: "Unread messages"; color: Theme.accent; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Rectangle {
                                    x: msg.outgoing ? parent.width - msg.bubble-width - 14px : 14px;
                                    y: msg.bubble-y; width: msg.bubble-width; height: msg.bubble-height;
                                    background: msg.highlighted ? #386080 : msg.sticker ? transparent : msg.outgoing ? Theme.outgoing : Theme.incoming;
                                    border-top-left-radius: 12px; border-top-right-radius: 12px;
                                    border-bottom-left-radius: !msg.outgoing && msg.tail ? 4px : 12px;
                                    border-bottom-right-radius: msg.outgoing && msg.tail ? 4px : 12px;
                                    TouchArea {
                                        enabled: !root.blocked && root.action-dialog == 0;
                                        pointer-event(event) => {
                                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                root.open-menu(msg.key, msg.can-reply, msg.can-edit, msg.can-forward, msg.can-delete, msg.file-available,
                                                    self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                            }
                                        }
                                    }
                                    if msg.forwarded != "": Text {
                                        x: 10px; y: 6px; height: 18px; width: parent.width - 20px;
                                        text: msg.forwarded; color: Theme.accent; font-size: 13px; overflow: elide;
                                    }
                                    if msg.has-quote: Rectangle {
                                        x: 10px; y: msg.quote-y; width: parent.width - 20px; height: 40px;
                                        background: #6ab3f312; border-radius: 4px;
                                        Rectangle { x: 0px; y: 0px; width: 3px; height: parent.height; background: msg.quote-color; }
                                        Text { x: 9px; y: 2px; width: parent.width - 18px; height: 17px; text: msg.quote-sender; color: msg.quote-color; font-size: 13px; font-weight: 600; overflow: elide; }
                                        Text { x: 9px; y: 20px; width: parent.width - 18px; height: 17px; text: msg.quote-preview; color: Theme.text; font-size: 13px; overflow: elide; }
                                        TouchArea { clicked => { root.message-action(msg.key, 5); } }
                                    }
                                    if msg.sender != "": Text {
                                        x: 10px; y: msg.sender-y; width: parent.width - 20px; height: 18px;
                                        text: msg.sender; color: msg.sender-color; font-size: 13px; font-weight: 600; overflow: elide;
                                    }
                                    if msg.voice || msg.document: Rectangle {
                                        x: 10px; y: msg.attachment-y; height: 64px; width: parent.width - 20px;
                                        Rectangle {
                                            x: 0px; y: 7px; width: 44px; height: 44px; border-radius: 22px; background: Theme.badge;
                                            if msg.file-progress == "" && msg.voice: Path {
                                                x: 15px; y: 13px; width: 16px; height: 18px; viewbox-width: 16; viewbox-height: 18;
                                                fill: #ffffff; commands: msg.voice-playing ? "M1 1 H6 V17 H1 Z M10 1 H15 V17 H10 Z" : "M2 1 L15 9 L2 17 Z";
                                            }
                                            if msg.file-progress == "" && msg.document: Path {
                                                x: 12px; y: 10px; width: 20px; height: 24px; viewbox-width: 20; viewbox-height: 24;
                                                stroke: #ffffff; stroke-width: 1.5px; fill: transparent;
                                                commands: msg.file-available ? "M3 1 H12 L18 7 V23 H3 Z M12 1 V7 H18 M6 13 H15 M6 17 H13" : "M10 2 V17 M4 11 L10 17 L16 11 M3 21 H17";
                                            }
                                            if msg.document: Image { width: 44px; height: 44px; source: msg.attachment-image; image-fit: cover; }
                                            if msg.file-progress != "": Text { text: msg.file-progress; color: #ffffff; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        if msg.voice: Rectangle {
                                            x: 56px; y: 12px; width: parent.width - 56px; height: 28px;
                                            for bar[index] in msg.waveform: Rectangle {
                                                x: index * parent.width / 48; width: max(1px, parent.width / 48 - 2px);
                                                height: bar.amplitude; y: (parent.height - self.height) / 2;
                                                border-radius: 1px; background: bar.played ? Theme.accent : Theme.muted;
                                            }
                                            TouchArea { clicked => { root.attachment-action(msg.key, 1, self.mouse-x / self.width); } }
                                        }
                                        if msg.voice: Text { x: 56px; y: 43px; width: parent.width - 70px; height: 18px; text: msg.voice-time; color: Theme.muted; font-size: 12px; }
                                        if msg.voice && msg.voice-unlistened: Rectangle { x: parent.width - 7px; y: 48px; width: 5px; height: 5px; border-radius: 3px; background: Theme.accent; }
                                        if msg.document: Text { x: 56px; y: 9px; width: parent.width - 62px; height: 22px; text: msg.file-name; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                                        if msg.document: Text { x: 56px; y: 34px; width: parent.width - 62px; height: 20px; text: msg.file-size + (msg.file-downloading ? " / downloading" : msg.file-available ? " / Open file" : " / Download"); color: Theme.muted; font-size: 12px; overflow: elide; }
                                        TouchArea {
                                            width: msg.voice ? 48px : parent.width; height: parent.height;
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.attachment-action(msg.key, 0, 0); }
                                            pointer-event(event) => {
                                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                    root.open-menu(msg.key,msg.can-reply,msg.can-edit,msg.can-forward,msg.can-delete,msg.file-available,
                                                        self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y);
                                                }
                                            }
                                        }
                                    }
                                    if msg.media-height > 0px: Rectangle {
                                        x: 0px; y: msg.media-y; width: msg.media-width; height: msg.media-height; clip: true;
                                        border-top-left-radius: msg.round ? self.width / 2 : msg.media-y == 0px ? 12px : 0px;
                                        border-top-right-radius: msg.round ? self.width / 2 : msg.media-y == 0px ? 12px : 0px;
                                        border-bottom-left-radius: msg.round ? self.width / 2 : msg.media-caption ? 0px : !msg.outgoing && msg.tail ? 4px : 12px;
                                        border-bottom-right-radius: msg.round ? self.width / 2 : msg.media-caption ? 0px : msg.outgoing && msg.tail ? 4px : 12px;
                                        for cell[index] in msg.cells: Rectangle {
                                            x: cell.x; y: cell.y; width: cell.width; height: cell.height; background: msg.sticker ? transparent : Theme.field;
                                            Text { text: cell.label; color: Theme.muted; font-size: msg.sticker ? 80px : 13px; horizontal-alignment: center; vertical-alignment: center; }
                                            Image { source: cell.image; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; width: cell.raster-width > 0px ? cell.raster-width : parent.width; height: cell.raster-height > 0px ? cell.raster-height : parent.height; image-fit: msg.emoji ? contain : cover; }
                                            if cell.video || msg.round: Rectangle {
                                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                width: 48px; height: 48px; border-radius: 24px; background: play-touch.has-hover ? #000000a0 : #00000080;
                                                Path { x: 18px; y: 14px; width: 16px; height: 20px; viewbox-width: 16; viewbox-height: 20; fill: #ffffff; commands: msg.round && msg.voice-playing ? "M0 0 H5 V20 H0 Z M11 0 H16 V20 H11 Z" : "M0 0 L16 10 L0 20 Z"; }
                                            }
                                            if cell.video && cell.duration != "": Rectangle {
                                                x: 8px; y: 8px; height: 20px; width: duration-text.preferred-width + 14px; border-radius: 10px; background: #00000080;
                                                duration-text := Text { text: cell.duration; color: #ffffff; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                            play-touch := TouchArea {
                                                enabled: !root.blocked;
                                                pointer-event(event) => {
                                                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.up && root.action-dialog == 0 {
                                                        root.open-menu(msg.key, msg.can-reply, msg.can-edit, msg.can-forward, msg.can-delete, msg.file-available,
                                                            self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                    }
                                                }
                                                mouse-cursor: cell.video || msg.round ? MouseCursor.pointer : MouseCursor.default;
                                                clicked => { if msg.round { root.attachment-action(msg.key,0,0); } else if cell.video { root.open-video(row, index); } }
                                            }
                                        }
                                    }
                                    if msg.round: Rectangle {
                                        x: 6px; y: msg.media-y + msg.media-height + 4px; height: 20px;
                                        width: round-time.preferred-width + (msg.voice-unlistened ? 26px : 16px);
                                        border-radius: 10px; background: #00000080;
                                        round-time := Text { x: 8px; text: msg.file-progress != "" ? msg.file-progress : msg.voice-time;
                                            height: parent.height; color: #ffffff; font-size: 12px; vertical-alignment: center; }
                                        if msg.voice-unlistened: Rectangle { x: parent.width - 12px; y: 8px; width: 5px; height: 5px; border-radius: 3px; background: #ffffff; }
                                    }
                                    if msg.round && msg.file-downloading: Path {
                                        x: 0px; y: msg.media-y; width: msg.media-width; height: msg.media-height;
                                        viewbox-width: 100; viewbox-height: 100; fill: transparent; stroke: Theme.accent; stroke-width: 1.5px;
                                        commands: msg.round-progress;
                                    }
                                    if msg.text-height > 0px: Image { x: 10px; y: msg.text-y; width: msg.text-width; height: msg.text-height; source: msg.rendered; }
                                    if msg.time-over-media: Rectangle {
                                        x: msg.time-x - 6px; y: msg.time-y - 2px; height: 18px; border-radius: 9px; background: #00000070;
                                        width: msg.time-label-width + (msg.checks != 0 ? 18px : 0px) + 12px;
                                    }
                                    Text {
                                        x: msg.time-x; y: msg.time-y; width: msg.time-label-width; height: 14px; text: msg.time; font-size: 12px;
                                        horizontal-alignment: right; vertical-alignment: center;
                                        color: msg.time-over-media ? #ffffff : msg.outgoing ? Theme.time-out : Theme.time-in;
                                    }
                                    if msg.checks > 0: Path {
                                        x: msg.time-x + msg.time-label-width + 3px; y: msg.time-y + 2px; width: 15px; height: 10px;
                                        viewbox-width: 15; viewbox-height: 10; fill: transparent; stroke-width: 1.5px;
                                        stroke: msg.time-over-media ? #ffffff : Theme.check;
                                        commands: msg.checks == 2 ? "M0.5 5 L4 8.5 L10.5 1.5 M6 7.5 L7 8.5 L14 1.5" : "M2.5 5 L6 8.5 L12.5 1.5";
                                    }
                                    if msg.checks == -1: Path {
                                        x: msg.time-x + msg.time-label-width + 4px; y: msg.time-y + 1px; width: 12px; height: 12px;
                                        viewbox-width: 12; viewbox-height: 12; fill: transparent; stroke-width: 1.2px;
                                        stroke: msg.time-over-media ? #ffffff : Theme.time-out;
                                        commands: "M6 0.8 A5.2 5.2 0 1 0 6.01 0.8 M6 3 L6 6 L8 7.2";
                                    }
                                    if msg.checks == -2: Rectangle {
                                        x: msg.time-x + msg.time-label-width + 4px; y: msg.time-y; width: 14px; height: 14px; border-radius: 7px; background: #e5505a;
                                        Text { text: "!"; color: #ffffff; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                        }
                        if !root.chat-open: Rectangle {
                            width: empty-text.preferred-width + 28px; height: 28px; border-radius: 14px; background: Theme.date;
                            empty-text := Text { text: "Select a chat to start messaging"; color: Theme.text; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        if root.chat-open && (!root.follow-tail || !root.at-newest): Rectangle {
                            x: parent.width - 62px; y: parent.height - 62px; width: 46px; height: 46px; border-radius: 23px;
                            background: down-touch.has-hover ? #233040 : Theme.panel;
                            drop-shadow-blur: 6px; drop-shadow-color: #00000060;
                            Path { x: 15px; y: 18px; width: 16px; height: 10px; viewbox-width: 16; viewbox-height: 10;
                                stroke: Theme.muted; stroke-width: 2px; fill: transparent; commands: "M1 1 L8 8 L15 1"; }
                            if root.open-unread != "": Rectangle { x: -3px; y: -12px; height: 22px; min-width: 26px; width: max(26px, unread-label.preferred-width + 12px); border-radius: 11px; background: Theme.badge;
                                unread-label := Text { text: root.open-unread; color: #ffffff; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            down-touch := TouchArea { enabled: !root.blocked; clicked => { root.latest(); } }
                        }
                    }
                    if root.chat-open && root.composer-title != "": Rectangle {
                        height: 50px; background: Theme.panel;
                        Rectangle { x: 16px; y: 6px; width: 3px; height: 38px; background: Theme.accent; }
                        Text { x: 27px; y: 6px; height: 18px; width: parent.width - 80px; text: root.composer-title; color: Theme.accent; font-size: 13px; font-weight: 600; overflow: elide; }
                        Text { x: 27px; y: 25px; height: 18px; width: parent.width - 80px; text: root.composer-preview; color: Theme.muted; font-size: 13px; overflow: elide; }
                        Link { x: parent.width - 72px; y: 8px; width: 64px; text: "Cancel"; clicked => { root.cancel-action(); } }
                    }
                    if root.chat-open: Rectangle {
                        height: max(52px, min(170px, composer.preferred-height + 30px)); background: Theme.panel;
                        Rectangle { height: 1px; y: 0px; background: Theme.border; }
                        composer := TextInput {
                            in property <bool> focus-request: root.composer-focus;
                            changed focus-request => { self.focus(); }
                            x: 18px; y: 15px; width: parent.width - 18px - 60px; height: parent.height - 30px;
                            text <=> root.draft; color: Theme.text; font-size: 14px; wrap: word-wrap;
                            selection-background-color: #2b5278; selection-foreground-color: #ffffff;
                            enabled: !root.blocked;
                            key-pressed(event) => {
                                if event.text == Key.Escape { root.cancel-action(); return accept; }
                                if event.text == Key.Return && !event.modifiers.shift { root.send(); return accept; }
                                return reject;
                            }
                        }
                        if root.draft == "": Text { x: 18px; y: 15px; height: 20px; text: "Write a message..."; color: Theme.muted; font-size: 14px; }
                        Rectangle {
                            x: parent.width - 52px; y: parent.height - 46px; width: 40px; height: 40px; border-radius: 20px;
                            background: send-touch.has-hover && root.draft != "" ? Theme.hover : transparent;
                            Path { x: 9px; y: 10px; width: 22px; height: 20px; viewbox-width: 24; viewbox-height: 20;
                                fill: root.draft != "" ? Theme.accent : #4f5f70;
                                commands: "M1 9 L22 1 L18 19 L12 14 L9 18 L8 12 L18 4 L7 11 Z"; }
                            send-touch := TouchArea { enabled: !root.blocked && !root.edit-saving && root.draft != ""; clicked => { root.send(); } }
                        }
                    }
                }
            }
        }
    }
    if root.action-dialog != 0: Rectangle {
        background: #00000080;
        TouchArea { }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => { if event.text == Key.Escape { root.cancel-action(); return accept; } return reject; }
        }
        Rectangle {
            width: 420px; height: root.action-dialog == 1 ? 220px : root.action-dialog == 3 ? 260px : 440px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: 10px; background: Theme.panel;
            VerticalLayout {
                padding: 20px; spacing: 12px;
                Text { text: root.action-dialog == 1 ? "Delete message?" : root.action-dialog == 3 ? "Open this file?" : "Forward to"; color: Theme.text; font-size: 19px; font-weight: 600; }
                if root.action-dialog == 3: Text { text: "This file can run code on your computer. Open it only if you trust its source."; color: Theme.text; font-size: 14px; wrap: word-wrap; }
                if root.action-dialog == 3: Text { text: root.file-name; color: Theme.muted; font-size: 14px; overflow: elide; }
                if root.action-dialog == 1: Text { text: "Delete the selected message or entire album?"; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
                if root.action-dialog == 1 && root.can-revoke: Rectangle {
                    height: 38px;
                    Rectangle { x: 0px; y: 9px; width: 18px; height: 18px; border-radius: 3px; border-width: 1px; border-color: Theme.accent; background: root.revoke ? Theme.badge : transparent;
                        if root.revoke: Path { x: 3px; y: 4px; width: 12px; height: 9px; viewbox-width: 12; viewbox-height: 9; fill: transparent; stroke: #ffffff; stroke-width: 2px; commands: "M1 4 L4 7 L11 1"; }
                    }
                    Text { x: 28px; width: parent.width - 28px; text: "Also delete for " + root.chat-title; color: Theme.text; font-size: 14px; overflow: elide; vertical-alignment: center; }
                    TouchArea { enabled: !root.must-revoke; clicked => { root.revoke = !root.revoke; } }
                }
                if root.action-dialog == 2: Input { text <=> root.forward-query; }
                if root.action-dialog == 2: ListView {
                    scrolled => { root.destination-y = self.content-y; }
                    for chat[index] in root.destinations: Rectangle {
                        height: 52px; background: dest-touch.has-hover ? Theme.hover : transparent;
                        Avatar { x: 4px; y: 5px; width: 40px; height: 40px; source: chat.avatar; initials: chat.initials; tint: chat.color; }
                        Text { x: 56px; width: parent.width - 62px; height: parent.height; text: chat.title; color: Theme.text; font-size: 14px; vertical-alignment: center; overflow: elide; }
                        dest-touch := TouchArea { clicked => { root.forward-to(index); } }
                    }
                }
                HorizontalLayout { alignment: end; spacing: 12px;
                    Link { text: "Cancel"; width: 100px; clicked => { root.cancel-action(); } }
                    if root.action-dialog == 3: Action { text: "Open"; width: 100px; clicked => { root.confirm-file(); } }
                    if root.action-dialog == 1: Action { text: "Delete"; width: 100px; clicked => { root.confirm-delete(); } }
                }
            }
        }
    }


    if root.menu-open: TouchArea {
        x: 0px; y: 0px; width: root.width; height: root.height;
        clicked => { root.menu-open = false; }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { root.menu-open = false; }
        }
        scroll-event(event) => { root.menu-open = false; return reject; }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.menu-open = false; return accept; }
                return reject;
            }
        }
        Rectangle {
            width: 210px; height: items.preferred-height;
            x: min(root.menu-x, root.width - self.width - 8px);
            y: min(root.menu-y, root.height - self.height - 8px);
            background: Theme.oled ? #121212 : #1d2733; border-radius: 10px;
            border-width: 1px; border-color: #ffffff0d;
            drop-shadow-blur: 16px; drop-shadow-offset-y: 4px; drop-shadow-color: #00000090;
            items := VerticalLayout {
                padding-top: 6px; padding-bottom: 6px;
                MenuRow {
                    text: "Reply"; enabled: root.menu-can-reply; clicked => { root.menu-pick(0); }
                    icon: "M10 8 L4 13 L10 18 M4 13 H14 C17.9 13 21 16.1 21 20";
                }
                if root.menu-can-edit: MenuRow {
                    text: "Edit"; clicked => { root.menu-pick(1); }
                    icon: "M4 20 L4.6 16.4 L15.5 5.5 L18.5 8.5 L7.6 19.4 Z M13.5 7.5 L16.5 10.5";
                }
                MenuRow {
                    text: "Copy Text"; clicked => { root.menu-pick(2); }
                    icon: "M9 8 H18 C18.6 8 19 8.4 19 9 V20 C19 20.6 18.6 21 18 21 H9 C8.4 21 8 20.6 8 20 V9 C8 8.4 8.4 8 9 8 Z M5 16 V4.5 C5 3.7 5.7 3 6.5 3 H15";
                }
                MenuRow {
                    text: "Forward"; enabled: root.menu-can-forward; clicked => { root.menu-pick(3); }
                    icon: "M14 8 L20 13 L14 18 M20 13 H10 C6.1 13 3 16.1 3 20";
                }
                if root.menu-can-reveal: MenuRow {
                    text: "Show in folder"; clicked => { root.menu-pick(6); }
                    icon: "M3 7 H10 L12 10 H21 V21 H3 Z M3 7 V4 H9 L12 7";
                }
                MenuRow {
                    text: "Delete"; enabled: root.menu-can-delete; clicked => { root.menu-pick(4); }
                    icon: "M4 7 H20 M9.5 7 V4.5 H14.5 V7 M6 7 L7 20 H17 L18 7 M10 11 V16.5 M14 11 V16.5";
                }
            }
        }
    }
}

// Media viewer: a separate window, as in Telegram Desktop. The video is drawn by a native child
// window over the area above the control bar; the Rust side places it from this window's size.
export component MediaViewer inherits Window {
    title: "Ferrogram - Media viewer";
    icon: @image-url("icon.png");
    background: #000000;
    // Borderless and centred over a dimmed backdrop by the player, as in Telegram Desktop.
    no-frame: true;
    preferred-width: 960px;
    preferred-height: 600px;
    min-width: 240px;
    min-height: 160px;
    default-font-family: "Segoe UI";
    in property <bool> loading;
    in property <bool> playing;
    in property <bool> failed;
    in property <float> progress;
    in property <string> time;
    out property <length> bar: 64px;
    callback toggle();
    callback seek(fraction: float);
    callback dismiss();
    callback area-changed();
    changed width => { root.area-changed(); }
    changed height => { root.area-changed(); }

        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.dismiss(); return accept; }
                if event.text == " " { root.toggle(); return accept; }
                return reject;
            }
        }
        if root.loading || root.failed: Text {
            width: parent.width; height: parent.height - root.bar;
            text: root.failed ? "This video cannot be played." : "Loading video...";
            color: #ffffffb0; font-size: 15px; horizontal-alignment: center; vertical-alignment: center;
        }
        Rectangle {
            y: parent.height - root.bar; height: root.bar; background: Theme.panel;
            Rectangle {
                x: 14px; y: 12px; width: 40px; height: 40px; border-radius: 20px;
                background: toggle-touch.has-hover ? Theme.hover : transparent;
                if root.playing: Path { x: 13px; y: 11px; width: 14px; height: 18px; viewbox-width: 14; viewbox-height: 18; fill: #ffffff; commands: "M0 0 L5 0 L5 18 L0 18 Z M9 0 L14 0 L14 18 L9 18 Z"; }
                if !root.playing: Path { x: 14px; y: 11px; width: 15px; height: 18px; viewbox-width: 15; viewbox-height: 18; fill: #ffffff; commands: "M0 0 L15 9 L0 18 Z"; }
                toggle-touch := TouchArea { clicked => { root.toggle(); } }
            }
            seek := Rectangle {
                x: 70px; y: 16px; width: parent.width - 70px - 170px; height: 32px;
                Rectangle { y: 14px; height: 4px; border-radius: 2px; background: #ffffff30; }
                Rectangle { x: 0px; y: 14px; height: 4px; border-radius: 2px; background: Theme.accent; width: parent.width * clamp(root.progress, 0, 1); }
                Rectangle {
                    x: parent.width * clamp(root.progress, 0, 1) - 6px; y: 10px; width: 12px; height: 12px; border-radius: 6px;
                    background: #ffffff; visible: seek-touch.has-hover;
                }
                seek-touch := TouchArea { clicked => { root.seek(self.mouse-x / self.width); } }
            }
            Text {
                x: parent.width - 160px; width: 100px; height: parent.height; text: root.time;
                color: Theme.muted; font-size: 13px; horizontal-alignment: right; vertical-alignment: center;
            }
            Rectangle {
                x: parent.width - 52px; y: 12px; width: 40px; height: 40px; border-radius: 20px;
                background: close-touch.has-hover ? Theme.hover : transparent;
                Path { x: 13px; y: 13px; width: 14px; height: 14px; viewbox-width: 14; viewbox-height: 14; stroke: #ffffff; stroke-width: 2px; fill: transparent; commands: "M1 1 L13 13 M13 1 L1 13"; }
                close-touch := TouchArea { clicked => { root.dismiss(); } }
            }
        }
    }
